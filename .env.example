# Copia este archivo como .env.local para desarrollo local
# En Vercel, configura estas mismas variables en Settings > Environment Variables
# NUNCA subas el archivo .env.local a Git (ya está en .gitignore)

# Token personal de Airtable (genera uno nuevo en https://airtable.com/create/tokens)
# Permisos requeridos: data.records:read y data.records:write
# Scope: solo la base del Directorio
AIRTABLE_TOKEN=patXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ID de la base de Airtable (lo encuentras en la URL: airtable.com/{BASE_ID}/...)
AIRTABLE_BASE_ID=appAI7XSQjwnEJjYj

# Nombre de la tabla (por defecto "Directorio")
AIRTABLE_TABLE=Directorio

# Clave compartida del grupo para permitir agregar registros
# Cámbiala por una más fuerte; los miembros del grupo la necesitarán para aportar
GRUPO_CLAVE=miraflores
